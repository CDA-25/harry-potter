<script src="hufflepuff-logo_fichiers/swipe-listener.min.js"></script><link rel="stylesheet" media="all" href="hufflepuff-logo_fichiers/base.css"><link rel="stylesheet" class="jdgm-stylesheet" media="all" href="hufflepuff-logo_fichiers/base.css"><script class="jdgm-script" type="text/javascript" src="hufflepuff-logo_fichiers/base.js" async=""></script><link class="jdgm-prefetch" rel="prefetch" as="script" href="https://cdnwidget.judge.me/widget/common.js"><link class="jdgm-prefetch" rel="prefetch" as="script" href="https://cdnwidget.judge.me/widget/main.js"><a class="jdgm-random-link jdgm-hidden" href="#" rel="nofollow" style="display: none;">Judge.me</a><style>
.jdgm-rev__icon::after { content: '\e001'; }
.jdgm-rev__icon::after,
.jdgm-rev__buyer-badge {
  display: inline-block;
  color: #ffffff;
  background-color: rgb(68, 68, 68);
}
.jdgm-rev__buyer-badge:before { content: 'Verified'; }

.jdgm-rev-widg__title { visibility: unset; }
.jdgm-rev-widg__summary-text { visibility: unset; }
.jdgm-prev-badge__text { visibility: unset; }

.jdgm-quest__body:before { content: 'Question:'; }
.jdgm-ans__body:before { content: 'Answer:'; }

.jdgm-star { color: #108474; }

.jdgm-ask-question-btn,
.jdgm-write-rev-link,
.jdgm-all-reviews-rating-wrapper,
.jdgm-carousel-wrapper a,
.jdgm-rev__prod-link,
.jdgm-all-reviews-text a,
.jdgm-carousel-item__product,
.jdgm-carousel-number-of-reviews,
.jdgm-revs-tab__url { color: rgb(68, 68, 68); }

a.jdgm-write-rev-link {
    color: rgb(68, 68, 68);
    background-color: #ffffff;
}

/* Legacy selectors, to keep old CSS specificities */
.jdgm-preview-badge .jdgm-star { color: #108474; }
.jdgm-histogram .jdgm-star { color: #108474; }
</style>
